{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Cinema ticket booking system with payment integration",
        "title": "Cinema Booking API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
